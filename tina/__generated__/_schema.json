{
  "version": {
    "fullVersion": "3.0.0",
    "major": "3",
    "minor": "0",
    "patch": "0"
  },
  "meta": { "flags": ["experimentalData"] },
  "collections": [
    {
      "name": "hero",
      "label": "Hero Section",
      "path": "src/content",
      "format": "json",
      "match": { "include": "hero" },
      "ui": { "allowedActions": { "create": false, "delete": false } },
      "fields": [
        {
          "type": "string",
          "name": "badge",
          "label": "Credentials Badge",
          "required": true,
          "namespace": ["hero", "badge"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "headline",
          "label": "Main Headline",
          "required": true,
          "namespace": ["hero", "headline"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "subheading",
          "label": "Subheading Copy",
          "required": true,
          "ui": { "component": "textarea" },
          "namespace": ["hero", "subheading"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "availabilityNotice",
          "label": "Availability Notice Banner",
          "required": true,
          "ui": { "component": "textarea" },
          "namespace": ["hero", "availabilityNotice"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "instagramUrl",
          "label": "Instagram URL Link",
          "required": true,
          "namespace": ["hero", "instagramUrl"],
          "searchable": true,
          "uid": false
        }
      ],
      "namespace": ["hero"]
    },
    {
      "name": "events",
      "label": "Events & Collaborations",
      "path": "src/content",
      "format": "json",
      "match": { "include": "events" },
      "ui": { "allowedActions": { "create": false, "delete": false } },
      "fields": [
        {
          "type": "string",
          "name": "title",
          "label": "Section Title",
          "required": true,
          "namespace": ["events", "title"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "description",
          "label": "Description Copy",
          "required": true,
          "ui": { "component": "textarea" },
          "namespace": ["events", "description"],
          "searchable": true,
          "uid": false
        }
      ],
      "namespace": ["events"]
    },
    {
      "name": "services",
      "label": "Services",
      "path": "src/content",
      "format": "json",
      "match": { "include": "services" },
      "fields": [
        {
          "type": "object",
          "name": "servicesList",
          "label": "Services Catalog List",
          "list": true,
          "fields": [
            {
              "type": "string",
              "name": "id",
              "label": "Service ID (slug)",
              "required": true,
              "namespace": ["services", "servicesList", "id"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "name",
              "label": "Service Name",
              "required": true,
              "namespace": ["services", "servicesList", "name"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "price",
              "label": "Price Display (e.g. $175)",
              "required": true,
              "namespace": ["services", "servicesList", "price"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "duration",
              "label": "Duration Display (e.g. 90 mins)",
              "required": true,
              "namespace": ["services", "servicesList", "duration"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "description",
              "label": "Short Description",
              "required": true,
              "namespace": ["services", "servicesList", "description"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "deliverables",
              "label": "Included Deliverables (List)",
              "list": true,
              "namespace": ["services", "servicesList", "deliverables"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "calSlug",
              "label": "Cal.com Scheduling Slug",
              "namespace": ["services", "servicesList", "calSlug"],
              "searchable": true,
              "uid": false
            }
          ],
          "namespace": ["services", "servicesList"],
          "searchable": true,
          "uid": false
        }
      ],
      "namespace": ["services"]
    },
    {
      "name": "portfolio",
      "label": "Portfolio Gallery",
      "path": "src/content",
      "format": "json",
      "match": { "include": "portfolio" },
      "fields": [
        {
          "type": "object",
          "name": "portfolioList",
          "label": "Showcase Images List",
          "list": true,
          "fields": [
            {
              "type": "string",
              "name": "id",
              "label": "Image ID (slug)",
              "required": true,
              "namespace": ["portfolio", "portfolioList", "id"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "image",
              "label": "Asset Source Path",
              "required": true,
              "namespace": ["portfolio", "portfolioList", "image"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "alt",
              "label": "Alt Text description",
              "required": true,
              "namespace": ["portfolio", "portfolioList", "alt"],
              "searchable": true,
              "uid": false
            },
            {
              "type": "string",
              "name": "tag",
              "label": "Style Category Tag",
              "namespace": ["portfolio", "portfolioList", "tag"],
              "searchable": true,
              "uid": false
            }
          ],
          "namespace": ["portfolio", "portfolioList"],
          "searchable": true,
          "uid": false
        }
      ],
      "namespace": ["portfolio"]
    },
    {
      "name": "site",
      "label": "Site Settings & SEO",
      "path": "src/content",
      "format": "json",
      "match": { "include": "site" },
      "ui": { "allowedActions": { "create": false, "delete": false } },
      "fields": [
        {
          "type": "string",
          "name": "studioName",
          "label": "Studio Name",
          "required": true,
          "namespace": ["site", "studioName"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "stylistName",
          "label": "Stylist Name",
          "required": true,
          "namespace": ["site", "stylistName"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "title",
          "label": "Browser Title (SEO)",
          "required": true,
          "namespace": ["site", "title"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "description",
          "label": "Meta Description",
          "required": true,
          "ui": { "component": "textarea" },
          "namespace": ["site", "description"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "email",
          "label": "Direct Email Address",
          "required": true,
          "namespace": ["site", "email"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "phone",
          "label": "Direct Phone Number",
          "required": true,
          "namespace": ["site", "phone"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "instagram",
          "label": "Instagram Handle (@...)",
          "required": true,
          "namespace": ["site", "instagram"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "locationDisplay",
          "label": "Location Display Text",
          "required": true,
          "namespace": ["site", "locationDisplay"],
          "searchable": true,
          "uid": false
        },
        {
          "type": "string",
          "name": "priceRange",
          "label": "Price Range Indicator ($$)",
          "namespace": ["site", "priceRange"],
          "searchable": true,
          "uid": false
        }
      ],
      "namespace": ["site"]
    }
  ],
  "config": {
    "media": { "tina": { "publicFolder": "public", "mediaRoot": "assets" } }
  }
}
